section.checkout
  .container
    script.
      function checkoutSubmit(form) {
        console.log(form.target)
      }

    form.js-form-validator(data-submit="checkoutSubmit").checkout__wrap
      h1 Оформление заказа

      .checkout__form
          .checkout__form-item.first
            .checkout__form-head
              .half
                div.half-first
                  .label-check
                    i
                     +svg("check")
                    span Заполните данные
                div.half-second
                  em Вы можете войти, чтобы данные заполнились автоматически
                  a(href="javascript:void(0)" data-remodal-target="reglogin" type="button").btn-silver
                    span ВОЙТИ В АККАУНТ 2

                  //- <a class="btn-silver" href="javascript:void(0)" data-remodal-target="reglogin">
                  //-                               <span>ВОЙТИ В АККАУНТ</span></a>

            .checkout__form-content
              .input-block
                input.js__input-notempty(type='text' name="text" value="text" required data-bouncer-target=".errmsg-checkout-name")
                span Имя
                em.errmsg.errmsg-checkout-name Заполните данное поле

              .input-block
                input.js__input-notempty(type='text' name="lastname" data-bouncer-target=".errmsg-checkout-name")
                span Фамилия
                em.errmsg.errmsg-checkout-name Заполните данное поле

              .input-block
                input.js__input-notempty(type='email' name="email" data-bouncer-target=".errmsg-checkout-email")
                span Email
                em.errmsg.errmsg-checkout-email Заполните данное поле

              .input-block
                input.js__input-notempty.js-phone-mask(type='tel' name="phone" required data-bouncer-target=".errmsg-checkout-phone")
                span Телефон
                em.errmsg.errmsg-checkout-phone Заполните данное поле

          .checkout__form-item.second
            .checkout__form-head
              .half
                div.half-first
                  .label-check
                    i
                     +svg("check")
                    span Доставка
                div.half-second
                  label.checkbox.pickupstore(for="id-pickupstore")
                    input(type="hidden", class="js-change-delivery-hidden" value='2')
                    input(type="checkbox", class="js-change-delivery", id="id-pickupstore", data-shop="2", data-curier="3")
                    span Забрать заказ из магазина

            .checkout__form-content
              .checkout-map
                //Inputs
                .checkout-map__inputs
                  .input-block.big
                    input.js__input-notempty(type='text' name="city" required data-bouncer-target=".errmsg-checkout-city")
                    span Город
                    em.errmsg.errmsg-checkout-city Заполните данное поле

                  .input-block.big
                    input.js__input-notempty(type='text' name="street" required data-bouncer-target=".errmsg-checkout-street")
                    span Улица
                    em.errmsg.errmsg-checkout-street Заполните данное поле

                  .input-block
                    input.js__input-notempty(type='text' name="house" required data-bouncer-target=".errmsg-checkout-house")
                    span Дом
                    em.errmsg.errmsg-checkout-house Заполните данное поле

                  .input-block
                    input.js__input-notempty(type='text' name="korpus" data-bouncer-target=".errmsg-checkout-korpus")
                    span Корпус
                    em.errmsg.errmsg-checkout-korpus Заполните данное поле

                  .input-block
                    input.js__input-notempty(type='text' name="podezd" data-bouncer-target=".errmsg-checkout-podezd")
                    span Подъезд
                    em.errmsg.errmsg-checkout-podezd Заполните данное поле

                  .input-block
                    input.js__input-notempty(type='text' name="kvartira" data-bouncer-target=".errmsg-checkout-kvartira")
                    span Квартира
                    em.errmsg.errmsg-checkout-kvartira Заполните данное поле

                  .input-block
                    input.js__input-notempty(type='text' name="etaj" data-bouncer-target=".errmsg-checkout-etaj")
                    span Этаж
                    em.errmsg.errmsg-checkout-etaj Заполните данное поле


                //Map
                .checkout-map__map
                  .head
                    em Россия, Москва
                    h2 Малый Конюшковский переулок дом 2

                    div
                      //a(href="tel:+7(495)223-60-20") +7 (495) 223-60-20
                      //a(href="tel:+7(495)517-74-46") +7 (495) 517-74-46
                      //span Пн-Пт: 10-20, Сб-Вс: 11-20

                      a(href="tel:+7 (495) 223-60-20") +7 (495) 223-60-20
                      span
                        em Пн-Пт: 10:00 - 20:00,
                        em Сб-Вс: 11:00 - 20:00

                  .map
                    script(src="https://api-maps.yandex.ru/2.1/?lang=ru_RU&amp;apikey=ec6bb29e-b209-4613-85ee-e55cc783f87e")
                    script.
                      let coords = [55.758240, 37.580193];
                      ymaps.ready(function() {
                        var myMap = new ymaps.Map("map", {
                                center: coords,
                                zoom: 13
                            }, {
                                //- searchControlProvider: 'yandex#search'
                            });

                        myMap.geoObjects
                            .add(new ymaps.Placemark(coords, {
                                balloonContent: 'цвет <strong>воды пляжа бонди</strong>'
                            }, {
                                preset: 'islands#icon',
                                iconColor: '#0095b6'
                            }))
                      });
                    #map

                .checkout__textarea
                  span Комментарий к заказу
                  .textarea-block
                    textarea.js__input-notempty(name="message" data-bouncer-target=".errmsg--checkoutmessage")
                    span Напишите что-нибудь
                    em.errmsg.errmsg--checkoutmessage Заполните данное поле

          .checkout__form-item.third
            .checkout__form-head
              .half
                div
                  .label-check
                    i
                      +svg("check")
                    span Оплата

            .checkout__form-content
              .payment-radio
                .payment-radio__item
                    input(type="radio" name="payment" id="payment-radio-1")
                    label(for="payment-radio-1").text-top
                      b При получении
                      span Оплата курьеру картой или наличными

                .payment-radio__item
                    input(type="radio" name="payment" id="payment-radio-3")
                    label(for="payment-radio-3")
                      b Счет для юридических лиц

                .payment-radio__item
                    input(type="radio" name="payment" id="payment-radio-4")
                    label(for="payment-radio-4")
                      b Яндекс.Касса





      .checkout__result
        .checkout__result-wrap
          .checkout__result-head
            span Итого
            em 9 500₽

          .checkout__result-content
            .line
              span Товаров на сумму
              em 12 500₽
            .line
              span Скидка
              em 2 500₽

          .checkout__result-footer
            label(for="policy-id").checkbox.policy-check
              input(type="checkbox" required name="policy" id="policy-id")
              span Я даю согласие на обработку личных данных в соответствии c
                a(href="#policy") политикой конфиденциальности

            button(type="submit" name="submit").btn-black
              span ПОДТВЕРДИТЬ ЗАКАЗ

            em Подтверждение заказа только для авторизованных пользователей


