section.indorder
  .container
    .indorder__wrap
      h2 Индивидуальный заказ
      p Для индивидуального заказа пришлите эскиз или фотографию понравившейся модели, можно добавить ссылку на изделие. Укажите, какой металл и вставки вы хотите, а также примерные характеристики камней. Мы просчитаем стоимость изготовления и согласуем её с Вами.
      em Для начала работ необходимо внести предоплату 50%

      form.indorder-form.js-form-validator(data-submit="indorderSbmit")
        .input-block.input-block--white
          input.js__input-notempty(type='text' name="name" required data-bouncer-target=".errmsg-name")
          span Имя
          em.errmsg.errmsg-name Заполните данное поле

        .input-block.input-block--white
          input.js__input-notempty.js-phone-mask(type='phone' name="phone" required data-bouncer-target=".errmsg-phone")
          span Телефон
          em.errmsg.errmsg-phone Заполните данное поле

        .input-block.input-block--white
          input.js__input-notempty(type='email' name="email" required data-bouncer-target=".errmsg-email")
          span Email
          em.errmsg.errmsg-email Заполните данное поле

        .textarea-block.textarea-block--white
          textarea.js__input-notempty(name="message" required data-bouncer-target=".errmsg-message")
          span Напишите что-нибудь
          em.errmsg.errmsg-message Заполните данное поле

        .input-file.js-input-file
          input(type="file" multiple name="file[]" required id="input-id-file")
          //label(for="input-id-file")
          //  +svg("clip")
          //  span Прикрепить файл


        .indorder-form__bottom
          button(type="submit" name="submit").btn-yellow
            span ОТПРАВИТЬ

          span Нажимая на кнопку «Отправить», я даю свое согласие с политикой обработки персональных данных
      script.
        function indorderSbmit() {
          console.log("Submit")
        }