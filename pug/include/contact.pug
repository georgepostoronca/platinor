section.contact
  .container
    .contact__wrap
      em Россия, Москва
      h1 Малый Конюшковский переулок 2
      .contact__phone
        a(href="tel:+7(495)223-60-20") +7 (495) 223-60-20
        a(href="mail:info@rpc-platina.ru") info@rpc-platina.ru

      .contact__time
        .contact__time-item
          b 10:00 - 20:00
          span Понедельник
          +svg("arrow")
          span Пятница
        .contact__time-item
          b 11:00 - 20:00
          span Суббота
          +svg("arrow")
          span Воскресенье

      .contact__info
        .contact__info-item
          em ИП
          span Гжелин Алексей Денисович
        .contact__info-item
          em ОГРНИП
          span 320774600123231
        .contact__info-item
          em ИНН
          span 773579761233

    .map
      script(src="https://api-maps.yandex.ru/2.1/?apikey=ec6bb29e-b209-4613-85ee-e55cc783f87e&load=Map&lang=ru_RU")
      script.
        let coords = [55.758240, 37.580193];
        ymaps.ready(function() {
          var myMap = new ymaps.Map("map", {
                  center: coords,
                  zoom: 13
              }, {
                  //- searchControlProvider: 'yandex#search'
              });

          myMap.geoObjects
              .add(new ymaps.Placemark(coords, {
                  balloonContent: 'цвет <strong>воды пляжа бонди</strong>'
              }, {
                  preset: 'islands#icon',
                  iconColor: '#0095b6'
              }))
        });
      #map

