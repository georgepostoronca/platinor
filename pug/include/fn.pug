mixin svg(name, className)
  svg(class="icon" + (className ? " " + className : ""))
    use(xlink:href="ico/sprite.svg#" + name)

mixin social
  .social
    ul
      li
        a(href="#vk")
         +svg("vk")

      li
        a(href="#fb")
          +svg("fb")

      li
        a(href="#in")
          +svg("in")