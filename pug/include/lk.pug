section.blocklk
  .container
    .blocklk__wrap
      h1 Личный кабинет

      //Tabs
      .tabs.js-tabs
        //Head
        .tabs__head.js-tabhead
          button(type="button" data-hash="#lk").tabs__btn.js-tabs-btn
            | ЛИЧНЫЕ ДАННЫЕ
          button(type="button" data-hash="#history").tabs__btn.js-tabs-btn
            | ИСТОРИЯ ЗАКАЗОВ

        //Content
        .tabs__content
          .tabs__content-item.js-tabs-content
            .label.label-success
              svg(class="icon")
                use(xlink:href="ico/sprite.svg#check")
              span Вы успешно изменили пароль

            .label.label-error
              svg(class="icon")
                use(xlink:href="ico/sprite.svg#close")
              span Lorem ipsum dolor sit amet

            form.tabs-form.js-form-validator(data-submit="submitTabsForm")
              .simple-input
                label(for="label-id-name") Имя
                input(id="label-id-name" name="name" required)

              .simple-input.label-max
                label(for="label-id-familly") Фамилия
                input(id="label-id-familly" name="familly" required)

              .simple-input
                label(for="label-id-email") Email
                input(id="label-id-email" type="email" name="email" required)

              .simple-input.label-max
                label(for="label-id-phone") Телефон
                input.js-phone-mask(id="label-id-phone" type="phone" name="phone" required)

              .tabs-form__bottom
                .input-date
                  label(for="input-id-date") Дата рождения
                  input(id="input-id-date" type="date" min="1920-01-01" max="2050-12-31" name="date" value="1999-01-01" placeholder="дд.мм.гггг" required)

                .block-check
                  span Ваш пол
                  .input-check
                    input(id="input-check-gender-m" type="radio" name="gender" value="M" required checked)
                    label(for="input-check-gender-m") Мужской
                  .input-check
                    input(id="input-check-gender-f" type="radio" name="gender" value="F" required)
                    label(for="input-check-gender-f") Женский

              .tabs-form__newpass.js-block-newpass
                .simple-input
                  label(for="label-id-password") Пароль
                  input(id="label-id-password" type="password" name="password")

                .simple-input.label-max
                  label(for="label-id-repetpass") Повторить пороль
                  input(id="label-id-repetpass" type="password" name="repeat-pass" data-bouncer-match="#label-id-password")

              .tabs-form__btns
                a(href="#rmeove-account").btn-text УДАЛИТЬ АККАУНТ

                .btn-group
                  button(type="button").btn-silver.js-open-newpass
                    span ИЗМЕНИТЬ ПАРОЛЬ
                  button(type="submit" name="submit").btn-black
                    span СОХРАНИТЬ ИЗМЕНЕНИЯ

            script.
              function submitTabsForm(fn) {
                console.log("Submit Tabs Form");
                console.log(fn);
              }

