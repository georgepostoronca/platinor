//reglogin
.remodal.remodal-rel.js-modal(data-remodal-id='reglogin')
  button(data-remodal-action="close" class="remodal-close")
  .cmodal
    .cmodal-item.cmodal-rel-reglogin.cmodal-reglogin.active
      .cmodal-tab__wrap
        .cmodal-tab__btn.js-tabmodal-btn.active(data-modal=".cmodal-login")
          span Вход
        .cmodal-tab__btn.js-tabmodal-btn(data-modal=".cmodal-reg")
          span Регистрация

      //Modal Login
      .cmodal-item.js-tabmodal-content.cmodal-rel-login.cmodal-login.active
        form.js-form-validator
          h2 Вход

          .cmodal-social
            span Через соц-сети:
            +social

          .input-block
            input.js__input-notempty(type='email' name="email" required data-bouncer-target=".errmsg-login-email")
            span Email
            em.errmsg.errmsg-login-email Заполните данное поле

          .input-block
            input.js__input-notempty.js-no-pass-check(type='password' minlength="8" name="password" required data-bouncer-target=".errmsg-login-password")
            span Пароль
            em.errmsg.errmsg-login-password Заполните данное поле

          button(type="submit" name="submit").btn-yellow.cmodal-submit
            span ВОЙТИ НА САЙТ

          .btn-forgot

            a(href="#Забыли-пароль?")
              span Забыли пароль?



      //Modal Reg
      .cmodal-item.js-tabmodal-content.cmodal-rel-reg.cmodal-reg
        form.js-form-validator(data-submit="modalRegSubmit")
          h2 Регистрация

          .cmodal-social
            span Через соц-сети:
            +social

          .input-block
            input.js__input-notempty(type='text' name="name" required data-bouncer-target=".errmsg-modal-reg-name")
            span Имя
            em.errmsg.errmsg-modal-reg-name Заполните данное поле

          .input-block
            input.js__input-notempty(type='text' name="name" required data-bouncer-target=".errmsg-modal-reg-name")
            span Фамилия
            em.errmsg.errmsg-modal-reg-name Заполните данное поле

          .input-block
            input.js__input-notempty(type='email' name="email" required data-bouncer-target=".errmsg-modal-reg-email")
            span Email
            em.errmsg.errmsg-modal-reg-email Заполните данное поле

          .input-block
            input.js__input-notempty(id="input-reg-pass" type='password' minlength="8" name="password" required data-bouncer-target=".errmsg-modal-reg-password")
            span Пароль
            em.errmsg.errmsg-modal-reg-password Заполните данное поле

          .input-block
            input.js__input-notempty(type='password' minlength="8" name="repeat-pass" required data-bouncer-match="#input-reg-pass" data-bouncer-target=".errmsg-modal-reg-repassword")
            span Повторите пароль
            em.errmsg.errmsg-modal-reg-repassword Заполните данное поле

          button(type="submit" name="submit").btn-yellow.cmodal-submit
            span ЗАРЕГИСТРИРОВАТЬСЯ

          p Нажимая на кнопку «Зарегистрироваться», вы даете согласие на обработку личных данных в соответствии c политикой конфиденциальности,



    //Modal Phone
    .cmodal-item.cmodal-phone.cmodal-rel-phone
      form.js-form-validator(data-submit="modalPhoneSubmit")
        h2 Телефон

        .input-block
          input.js__input-notempty.js-phone-mask(type='phone' name="phone" required data-bouncer-target=".errmsg-modal-phone-phone")
          span Телефон
          em.errmsg.errmsg-modal-phone-phone Заполните данное поле

        button(type="submit" name="submit").btn-yellow.cmodal-submit
          span Получить код



    //Modal Phone Number
    .cmodal-item.cmodal-phonenum.cmodal-middle.cmodal-rel-phonenum
      form.js-form-validator(data-submit="modalPhoneNumSubmit")
        .cmodal-head
          h2 Подтверждение телефона

          span Введите код высланный по указанному телефону

        .number-block.js-phone-code

        .cmodal-footer
          button(type="submit" name="submit").btn-yellow.cmodal-submit
            span ПОДТВЕРДИТЬ
          span.text-repeat
            | Отправить повторно можно через
            span 90
            | секунд
          a(href="#resend").link-resend Не приходит СМС

    //Modal Success
    .cmodal-item.cmodal-success.cmodal-max.cmodal-rel-success
      +svg("check")
      h2 Спасибо, ваша заявка была успешно отправлена
      span В течении 24 часов мы свяжемся с вами
      button(type="button" data-remodal-action="close").btn-yellow
        span ВЕРНУТЬСЯ


