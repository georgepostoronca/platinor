      script.
        $(".link-resend").each(function() {
          $(this).click(function () {

            if($(this).closest(".remodal").hasClass("remodal-rep")) {
              $(".remodal-rep .cmodal-item").removeClass("active");
              $(".cmodal-rep-phone").addClass("active");
            }

            if ($(this).closest(".remodal").hasClass("remodal-rel")) {
              $(".remodal-rel .cmodal-item").removeClass("active");
              $(".cmodal-rel-phone").addClass("active");
            }

            // startTimer($(".link-resend"), true);
            clearInterval(timerGlobalId)
            timervalue1 = 0;
          });
        });


        /* Функция правильных окончаний для чисел */
        function getWord(count, ending1, ending2, ending3) {
          var thisResult = '';
          var countLast = parseInt(count.toString().substr(-1));
          if (countLast == 1) {
            thisResult = ending1;
          } else if ((countLast >= 2) && (countLast <= 4)) {
            thisResult = ending2;
          } else {
            thisResult = ending3;
          }
          if ((count >= 11) && (count <= 14)) {
            thisResult = ending3;
          }
          return count + ' ' + thisResult;
        }


        var timerGlobalId;
        function startTimer(form, value) {
          let timer = 90;

          if(timerGlobalId) {
            clearInterval(timerGlobalId)
          }

          timerGlobalId = setInterval(function() {
            timer--;
            window[value] = timer;
            form.text(timer);

            if(timer === 0) {
              clearInterval(timerGlobalId);
            }
          }, 1000);
        }

        function modalRegSubmit() {
          $(".cmodal-rel-reglogin").removeClass("active");
          $(".cmodal-rel-phone").addClass("active");
        }

        function modalPhoneSubmit(form) {
          $(".cmodal-rel-phone").removeClass("active");
          $(".cmodal-rel-phonenum").addClass("active");
        }

        function modalPhoneNumSubmit() {
          $(".cmodal-rel-phonenum").removeClass("active");
          $(".cmodal-rel-success").addClass("active");
        }

        // Rep
        var timervalue1 = 0;
        function modalRepPhoneSubmit(form) {
          console.log("modalRepPhoneSubmit")
          $(".cmodal-rep-phone").removeClass("active");
          $(".cmodal-rep-phonenum").addClass("active");
          $(".cmodal-rep-phonenum").find(".text-repeat span").text(90);
          startTimer($(".cmodal-rep-phonenum").find(".text-repeat span"), "timervalue1");
        }

        function modalRepPhoneNumSubmit() {
          console.log("modalRepPhoneNumSubmit")
          $(".cmodal-rep-phonenum").removeClass("active");
          $(".cmodal-rep-pass").addClass("active");
        }

        function modalRepPassSubmit() {
          console.log("modalRepPassSubmit")
          $(".cmodal-rep-pass").removeClass("active");
          $(".cmodal-rep-success").addClass("active");
        }


